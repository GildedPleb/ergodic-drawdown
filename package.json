{
  "name": "escape-velocity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "lint": "oxlint -D correctness -D suspicious -A unicorn/require-post-message-target-origin --type-aware --type-check src vite.config.ts",
    "format": "oxfmt --check",
    "preview": "vite preview",
    "test": "npx esbuild src/dynamic-array-test.ts --bundle --platform=node --outfile=out.js && node out.js"
  },
  "dependencies": {
    "@mdx-js/rollup": "^3.0.1",
    "@tanstack/react-query": "^5.51.15",
    "chart.js": "^4.4.3",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chartjs-plugin-annotation": "^3.0.1",
    "chartjs-plugin-zoom": "^2.0.1",
    "date-fns": "^3.6.0",
    "hash-sum": "^2.0.0",
    "lru-cache": "^11.0.0",
    "memoizee": "^0.4.17",
    "quickselect": "^3.0.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "react-toastify": "^11.0.2",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.0.0",
    "styled-components": "^6.1.12",
    "styled-reset": "^4.5.2"
  },
  "devDependencies": {
    "@svgr/core": "^8.1.0",
    "@types/hash-sum": "^1.0.2",
    "@types/memoizee": "^0.4.11",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "@vitejs/plugin-react": "^4.3.1",
    "c8": "^10.1.2",
    "oxfmt": "*",
    "oxlint": "*",
    "oxlint-tsgolint": "*",
    "typescript": ">=7.0.0",
    "vite": "^5.3.1",
    "vite-plugin-svgr": "^4.2.0"
  },
  "browserslist": [
    "defaults and supports es6-module",
    "node >= 18"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
