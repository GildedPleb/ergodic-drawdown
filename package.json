{
  "name": "escape-velocity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "lint": "oxlint -D correctness -D suspicious -A unicorn/require-post-message-target-origin --type-aware --type-check src test scripts vite.config.ts",
    "format": "oxfmt --check",
    "knip": "knip --treat-config-hints-as-errors",
    "preview": "vite preview",
    "test": "bun scripts/check-coverage.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.2",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chartjs-plugin-annotation": "^3.1.0",
    "chartjs-plugin-zoom": "^2.2.0",
    "date-fns": "^4.4.0",
    "hash-sum": "^2.0.0",
    "lru-cache": "^11.5.3",
    "memoizee": "^0.4.17",
    "quickselect": "^3.0.0",
    "react": "^19.3.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.0",
    "react-toastify": "^11.1.0",
    "styled-components": "^6.6.0",
    "styled-reset": "^5.0.0"
  },
  "devDependencies": {
    "@types/hash-sum": "^1.0.2",
    "@types/memoizee": "^0.4.12",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "knip": "^6.41.0",
    "oxfmt": "*",
    "oxlint": "*",
    "oxlint-tsgolint": "*",
    "typescript": ">=7.0.0",
    "vite": "^8.3.4"
  },
  "browserslist": [
    "defaults and supports es6-module",
    "node >= 18"
  ],
  "engines": {
    "bun": "1.3.13"
  },
  "packageManager": "bun@1.3.13"
}
