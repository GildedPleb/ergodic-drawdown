{
  "name": "escape-velocity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/update-weekly-prices.ts && tsc -b && vite build",
    "dev": "bun scripts/update-weekly-prices.ts && vite",
    "lint": "oxlint -D correctness -D suspicious -D typescript/no-misused-promises -A unicorn/require-post-message-target-origin --type-aware --type-check src test scripts vite.config.ts && bun scripts/v2/css/stylelint-gate.ts",
    "format": "oxfmt --check",
    "knip": "knip --treat-config-hints-as-errors && bun run design:absent",
    "prepare": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then lefthook install; fi",
    "preview": "vite preview",
    "secrets": "bun scripts/gitleaks.ts protect --staged --redact --no-banner",
    "test": "bun scripts/check-coverage.ts",
    "golden": "bun scripts/capture-golden.ts",
    "golden:check": "bun scripts/capture-golden.ts --check",
    "typecheck": "tsc -b",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "tokens": "bun scripts/v2/generate-tokens.ts",
    "css:enforce": "bun scripts/v2/css/cli.ts",
    "css:size": "bun scripts/v2/measure-css-size.ts",
    "design:absent": "bun scripts/v2/check-design-route-absent.ts",
    "visual": "playwright test -c test/visual/playwright.config.ts",
    "visual:update": "VISUAL_UPDATE=1 playwright test -c test/visual/playwright.config.ts --update-snapshots",
    "models:golden": "bun scripts/v2/main-models-golden.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.4",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chartjs-plugin-annotation": "^3.1.0",
    "chartjs-plugin-zoom": "^2.2.0",
    "date-fns": "^4.4.0",
    "hash-sum": "^2.0.0",
    "memoizee": "^0.4.17",
    "quickselect": "^3.0.0",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "react-toastify": "^11.1.0",
    "styled-components": "^6.6.0",
    "styled-reset": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.64.1",
    "@storybook/react": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@types/hash-sum": "^1.0.2",
    "@types/memoizee": "^0.4.12",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "knip": "^6.41.0",
    "lefthook": "2.2.2",
    "oxc-parser": "0.153.0",
    "oxfmt": "*",
    "oxlint": "*",
    "oxlint-tsgolint": "*",
    "postcss": "8.5.31",
    "storybook": "10.6.2",
    "stylelint": "17.16.0",
    "typescript": ">=7.0.0",
    "vite": "^8.3.4"
  },
  "browserslist": [
    "defaults and supports es6-module",
    "node >= 18"
  ],
  "engines": {
    "bun": "1.3.13"
  },
  "packageManager": "bun@1.3.13"
}
