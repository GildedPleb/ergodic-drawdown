{
  "name": "escape-velocity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/update-weekly-prices.ts && bun --bun x tsc -b && bun --bun x vite build",
    "dev": "bun scripts/update-weekly-prices.ts && vite",
    "lint": "oxlint -D correctness -D suspicious -D typescript/no-misused-promises -A unicorn/require-post-message-target-origin --type-aware --type-check src test scripts vite.config.ts",
    "format": "oxfmt --check",
    "knip": "knip --treat-config-hints-as-errors",
    "prepare": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then lefthook install; fi",
    "preview": "vite preview",
    "secrets": "bun scripts/gitleaks.ts protect --staged --redact --no-banner",
    "test": "bun scripts/check-coverage.ts",
    "golden": "bun scripts/capture-golden.ts",
    "golden:check": "bun scripts/capture-golden.ts --check",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chartjs-plugin-annotation": "^3.1.0",
    "chartjs-plugin-zoom": "^2.2.0",
    "date-fns": "^4.4.0",
    "hash-sum": "^2.0.0",
    "memoizee": "^0.4.17",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "react-toastify": "^11.1.0",
    "styled-components": "^6.6.0",
    "styled-reset": "^5.0.0"
  },
  "devDependencies": {
    "@types/hash-sum": "^1.0.2",
    "@types/memoizee": "^0.4.12",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "knip": "^6.42.1",
    "lefthook": "2.2.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2",
    "vite": "^8.3.5"
  },
  "browserslist": [
    "defaults and supports es6-module",
    "node >= 18"
  ],
  "engines": {
    "bun": "1.4.3"
  },
  "packageManager": "bun@1.4.3"
}
